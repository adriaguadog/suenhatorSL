<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.suenhator.controller.FormularioInvitadoViewController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@styles.css"
            styleClass="scrollpane-formulario-blanco">

    <content>
        <VBox spacing="10"
              styleClass="panel-vista-modulo formulario-reserva-compacto fondo-blanco-formulario">

            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <!-- barra superior: título + descripción + botones -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="2">
                    <Label text="Formulario de invitados"
                           styleClass="etiqueta-titulo-seccion"/>
                    <Label text="Registro y asociación de invitados a la reserva."
                           wrapText="true"
                           styleClass="etiqueta-descripcion-seccion"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="botonLimpiarFormularioInvitado"
                        mnemonicParsing="false"
                        text="Limpiar"
                        styleClass="boton-accion-secundaria"/>

                <Button fx:id="botonGuardarInvitado"
                        mnemonicParsing="false"
                        text="Guardar invitado"
                        styleClass="boton-accion-principal"/>
            </HBox>

            <VBox spacing="8">

                <VBox spacing="8"
                      styleClass="tarjeta-contenido-principal">
                    <Label text="Datos del invitado"
                           styleClass="etiqueta-subtitulo-bloque"/>

                    <HBox spacing="8">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nombre"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoNombreInvitado"
                                       promptText="Nombre"/>
                        </VBox>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Apellidos"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoApellidosInvitado"
                                       promptText="Apellidos"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="8">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="DNI"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoDniInvitado"
                                       promptText="DNI"/>
                        </VBox>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Teléfono"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoTelefonoInvitado"
                                       promptText="Teléfono"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="8">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Email"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoEmailInvitado"
                                       promptText="Correo electrónico"/>
                        </VBox>

                        <VBox spacing="4" prefWidth="180">
                            <Label text="Fecha de nacimiento"
                                   styleClass="etiqueta-campo-formulario"/>
                            <DatePicker fx:id="selectorFechaNacimientoInvitado"
                                        maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="8">
                        <Button fx:id="botonNuevoInvitado"
                                mnemonicParsing="false"
                                text="Nuevo"
                                styleClass="boton-accion-secundaria"/>

                        <Button fx:id="botonAnadirInvitadoAReserva"
                                mnemonicParsing="false"
                                text="Añadir a la reserva"
                                styleClass="boton-accion-principal"/>

                        <Button fx:id="botonEliminarInvitadoSeleccionado"
                                mnemonicParsing="false"
                                text="Quitar invitado"
                                styleClass="boton-accion-peligro"/>
                    </HBox>
                </VBox>

                <VBox spacing="8"
                      styleClass="tarjeta-contenido-principal">
                    <Label text="Invitados preparados"
                           styleClass="etiqueta-subtitulo-bloque"/>

                    <ListView fx:id="listViewInvitadosPreparados"
                              prefHeight="260"/>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
