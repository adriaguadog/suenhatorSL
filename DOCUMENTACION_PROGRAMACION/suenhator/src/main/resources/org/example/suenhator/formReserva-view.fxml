<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.suenhator.controller.FormularioReservaViewController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@styles.css"
            styleClass="scrollpane-formulario-blanco">

    <content>
        <VBox spacing="10"
              styleClass="panel-vista-modulo">

            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="2">
                    <Label text="Formulario de reserva"
                           styleClass="etiqueta-titulo-seccion"/>
                    <Label text="Alta y gestión de reservas con invitados y personalización."
                           wrapText="true"
                           styleClass="etiqueta-texto-secundario"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="botonCancelar"
                        mnemonicParsing="false"
                        text="Cancelar"
                        styleClass="boton-accion-secundaria"/>

                <Button fx:id="botonLimpiar"
                        mnemonicParsing="false"
                        text="Limpiar"
                        styleClass="boton-accion-secundaria"/>

                <Button fx:id="botonGuardar"
                        mnemonicParsing="false"
                        text="Guardar reserva"
                        styleClass="boton-accion-principal"/>
            </HBox>

            <HBox spacing="10">

                <VBox spacing="8" HBox.hgrow="ALWAYS">

                    <VBox spacing="8"
                          styleClass="tarjeta-contenido-principal">
                        <Label text="Cliente"
                               styleClass="etiqueta-subtitulo-bloque"/>

                        <HBox spacing="8">
                            <TextField fx:id="campoTextoDni"
                                       promptText="Buscar cliente por DNI"
                                       styleClass="campo-entrada-datos"
                                       HBox.hgrow="ALWAYS"/>

                            <Button fx:id="botonBuscarCliente"
                                    mnemonicParsing="false"
                                    text="Buscar cliente"
                                    styleClass="boton-accion-secundaria"/>
                        </HBox>

                        <Label fx:id="etiquetaClienteEncontrado"
                               text="Cliente no seleccionado"
                               wrapText="true"
                               styleClass="etiqueta-detalle-campo"/>
                    </VBox>

                    <VBox spacing="8"
                          styleClass="tarjeta-contenido-principal">
                        <Label text="Datos principales de la reserva"
                               styleClass="etiqueta-subtitulo-bloque"/>

                        <HBox spacing="8">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Pack"
                                       styleClass="etiqueta-campo-formulario"/>
                                <ComboBox fx:id="selectorPack"
                                          styleClass="campo-entrada-datos"
                                          maxWidth="1.7976931348623157E308"/>
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Sala"
                                       styleClass="etiqueta-campo-formulario"/>
                                <ComboBox fx:id="selectorSala"
                                          styleClass="campo-entrada-datos"
                                          maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Supervisor"
                                       styleClass="etiqueta-campo-formulario"/>
                                <ComboBox fx:id="selectorSupervisor"
                                          styleClass="campo-entrada-datos"
                                          maxWidth="1.7976931348623157E308"/>
                            </VBox>

                            <VBox spacing="4" prefWidth="170">
                                <Label text="Fecha"
                                       styleClass="etiqueta-campo-formulario"/>
                                <DatePicker fx:id="selectorFecha"
                                            styleClass="campo-entrada-datos"
                                            maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <VBox spacing="4" prefWidth="140">
                                <Label text="Hora"
                                       styleClass="etiqueta-campo-formulario"/>
                                <TextField fx:id="campoHora"
                                           promptText="18:30"
                                           styleClass="campo-entrada-datos"/>
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Estado de reserva"
                                       styleClass="etiqueta-campo-formulario"/>
                                <ComboBox fx:id="selectorEstadoReserva"
                                          styleClass="campo-entrada-datos"
                                          maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="8"
                          styleClass="tarjeta-contenido-principal">
                        <Label text="Invitados de la reserva"
                               styleClass="etiqueta-subtitulo-bloque"/>

                        <HBox spacing="8">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Nombre"
                                       styleClass="etiqueta-campo-formulario"/>
                                <TextField fx:id="campoNombreInvitado"
                                           promptText="Nombre del invitado"
                                           styleClass="campo-entrada-datos"/>
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Apellidos"
                                       styleClass="etiqueta-campo-formulario"/>
                                <TextField fx:id="campoApellidosInvitado"
                                           promptText="Apellidos"
                                           styleClass="campo-entrada-datos"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <VBox spacing="4" prefWidth="140">
                                <Label text="DNI"
                                       styleClass="etiqueta-campo-formulario"/>
                                <TextField fx:id="campoDniInvitado"
                                           promptText="12345678A"
                                           styleClass="campo-entrada-datos"/>
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Teléfono"
                                       styleClass="etiqueta-campo-formulario"/>
                                <TextField fx:id="campoTelefonoInvitado"
                                           promptText="600123456"
                                           styleClass="campo-entrada-datos"/>
                            </VBox>

                            <VBox spacing="4" prefWidth="140">
                                <Label text="Fecha nac."
                                       styleClass="etiqueta-campo-formulario"/>
                                <DatePicker fx:id="selectorFechaNacInvitado"
                                            styleClass="campo-entrada-datos"
                                            maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Email"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoEmailInvitado"
                                       promptText="email@ejemplo.com"
                                       styleClass="campo-entrada-datos"/>
                        </VBox>

                        <HBox spacing="8">
                            <Button fx:id="botonGuardarInvitado"
                                    mnemonicParsing="false"
                                    text="Guardar invitado"
                                    styleClass="boton-accion-principal"/>

                            <Button fx:id="botonLimpiarInvitado"
                                    mnemonicParsing="false"
                                    text="Limpiar"
                                    styleClass="boton-accion-secundaria"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="botonQuitarInvitado"
                                    mnemonicParsing="false"
                                    text="Quitar seleccionado"
                                    styleClass="boton-accion-peligro"/>
                        </HBox>

                        <ListView fx:id="listViewInvitados"
                                  styleClass="lista-datos-principal"
                                  prefHeight="140"/>

                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Total invitados:"
                                   styleClass="etiqueta-texto-secundario"/>
                            <Label fx:id="etiquetaTotalInvitados"
                                   text="0"
                                   styleClass="etiqueta-detalle-campo"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="8" prefWidth="340">
                    <VBox spacing="8"
                          styleClass="tarjeta-detalle-lateral">
                        <Label text="Personalización"
                               styleClass="etiqueta-subtitulo-bloque"/>

                        <VBox spacing="4">
                            <Label text="Vídeo de referencia"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextField fx:id="campoVideo"
                                       promptText="Ruta o enlace del vídeo"
                                       styleClass="campo-entrada-datos"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Descripción"
                                   styleClass="etiqueta-campo-formulario"/>
                            <TextArea fx:id="areaDescripcionPersonalizacion"
                                      wrapText="true"
                                      prefRowCount="4"
                                      styleClass="area-texto-datos"
                                      promptText="Describe la personalización deseada"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Estado de personalización"
                                   styleClass="etiqueta-campo-formulario"/>
                            <ComboBox fx:id="selectorEstadoPersonalizacion"
                                      styleClass="campo-entrada-datos"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>