<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.suenhator.controller.ComprasViewController"
            stylesheets="@styles.css"
            styleClass="scrollpane-formulario-blanco">

    <content>
        <VBox spacing="14" styleClass="panel-vista-modulo">
            <padding>
                <Insets top="18" right="26" bottom="18" left="26" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label styleClass="etiqueta-titulo-seccion" text="Compras" />
                    <Label styleClass="etiqueta-texto-secundario"
                           text="Busca al cliente, consulta sus compras y modifica la compra seleccionada antes del pago."
                           wrapText="true" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">

                <VBox spacing="12"
                      styleClass="tarjeta-contenido-principal, panel-maestro"
                      prefWidth="430">

                    <Label styleClass="etiqueta-subtitulo-bloque" text="Cliente y compras" />

                    <HBox spacing="10" styleClass="barra-filtros">
                        <TextField fx:id="campoDniClienteCompra"
                                   promptText="Introduce el DNI del cliente"
                                   styleClass="campo-entrada-datos"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="botonBuscarClientePorDni"
                                styleClass="boton-accion-secundaria"
                                text="Buscar" />
                    </HBox>

                    <Label fx:id="etiquetaClienteCompraSeleccionado"
                           styleClass="etiqueta-detalle-campo"
                           text="Ningún cliente seleccionado"
                           wrapText="true" />

                    <Label styleClass="etiqueta-subtitulo-bloque" text="Compras del cliente" />

                    <ListView fx:id="listViewComprasCliente"
                              styleClass="lista-datos-principal"
                              VBox.vgrow="ALWAYS" />
                </VBox>

                <VBox fx:id="tarjetaDetalleCompra"
                      spacing="10"
                      styleClass="tarjeta-detalle-lateral"
                      HBox.hgrow="ALWAYS">

                    <Label styleClass="etiqueta-subtitulo-bloque" text="Detalle de compra" />

                    <GridPane hgap="10" vgap="8">
                        <Label text="Pack"
                               styleClass="etiqueta-campo-formulario"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />

                        <ComboBox fx:id="selectorPackCompra"
                                  promptText="Selecciona un pack"
                                  styleClass="campo-entrada-datos, combo-amplio"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="0" />

                        <Label text="Cantidad"
                               styleClass="etiqueta-campo-formulario"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                        <Spinner fx:id="selectorCantidadPackCompra"
                                 editable="true"
                                 styleClass="campo-entrada-datos"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="1" />

                        <columnConstraints>
                            <ColumnConstraints />
                            <ColumnConstraints />
                        </columnConstraints>
                    </GridPane>

                    <HBox spacing="8">
                        <Button fx:id="botonAnadirLineaCompra"
                                styleClass="boton-accion-secundaria"
                                text="Añadir linea" />
                        <Button fx:id="botonEliminarLineaCompra"
                                styleClass="boton-accion-secundaria"
                                text="Quitar línea" />
                    </HBox>

                    <Label styleClass="etiqueta-subtitulo-bloque" text="Líneas de compra" />

                    <ListView fx:id="listViewLineasCompra"
                              styleClass="lista-datos-secundaria"
                              VBox.vgrow="ALWAYS" />

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Label fx:id="etiquetaTotalCompra"
                               styleClass="etiqueta-total-resaltado"
                               text="Total: 0,00 €" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="botonGuardarCompra"
                                styleClass="boton-accion-principal"
                                text="Guardar" />

                        <Button fx:id="botonCancelarCompra"
                                styleClass="boton-accion-peligro"
                                text="Cancelar" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>