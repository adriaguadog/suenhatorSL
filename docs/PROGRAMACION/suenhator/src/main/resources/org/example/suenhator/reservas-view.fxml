<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.suenhator.controller.ReservasViewController"
            stylesheets="@styles.css"
            styleClass="scrollpane-formulario-blanco">

    <content>
        <VBox spacing="18" styleClass="panel-vista-modulo">
            <padding>
                <Insets top="26" right="26" bottom="26" left="26"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label styleClass="etiqueta-titulo-seccion" text="Gestión de reservas"/>
                    <Label styleClass="etiqueta-texto-secundario"
                           text="Busca reservas por cliente o por fecha y consulta su detalle."
                           wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- ESTE SE QUEDA DONDE ESTÁ -->
                <Button fx:id="botonAbrirFormularioNuevaReserva"
                        styleClass="boton-accion-principal"
                        text="Nueva reserva"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-filtros">
                <TextField fx:id="campoTextoDniClienteReserva"
                           prefWidth="240"
                           promptText="Buscar reservas por DNI del cliente"
                           styleClass="campo-entrada-datos, campo-busqueda"/>
                <DatePicker fx:id="selectorFiltroFechaReserva"
                            prefWidth="170"
                            styleClass="campo-entrada-datos"/>
                <Button fx:id="botonBuscarReserva"
                        styleClass="boton-accion-secundaria"
                        text="Buscar reserva"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">

                <VBox spacing="12"
                      styleClass="tarjeta-contenido-principal, panel-maestro"
                      HBox.hgrow="ALWAYS">
                    <Label styleClass="etiqueta-subtitulo-bloque" text="Listado de reservas"/>
                    <ListView fx:id="listViewReservas"
                              styleClass="lista-datos-principal"
                              VBox.vgrow="ALWAYS"/>
                </VBox>

                <VBox prefWidth="410" spacing="14" styleClass="tarjeta-detalle-lateral">
                    <Label styleClass="etiqueta-subtitulo-bloque" text="Detalle de la reserva"/>
                    <Label fx:id="etiquetaTituloReservaSeleccionada"
                           styleClass="etiqueta-titulo-detalle"
                           text="Selecciona una reserva"
                           wrapText="true"/>
                    <Label fx:id="etiquetaClienteReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Cliente"/>
                    <Label fx:id="etiquetaPackReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Pack"/>
                    <Label fx:id="etiquetaSalaReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Sala"/>
                    <Label fx:id="etiquetaSupervisorReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Supervisor"/>
                    <Label fx:id="etiquetaFechaHoraReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Fecha y hora"/>
                    <Label fx:id="etiquetaDuracionReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Duración aplicada"/>
                    <Label fx:id="etiquetaEstadoReserva"
                           styleClass="etiqueta-detalle-campo"
                           text="Estado"/>

                    <Label styleClass="etiqueta-subtitulo-bloque" text="Personalización asociada"/>
                    <Label fx:id="etiquetaDescripcionPersonalizacionReserva"
                           styleClass="etiqueta-texto-detalle"
                           text="No hay personalización asociada."
                           wrapText="true"/>

                    <!-- NUEVO: Modificar reserva aquí, encima del bloque inferior -->
                    <Button fx:id="botonModificarReservaSeleccionada"
                            styleClass="boton-accion-secundaria"
                            text="Modificar reserva"/>

                    <VBox spacing="10">
                        <Button fx:id="botonConfirmarReserva"
                                styleClass="boton-accion-principal"
                                text="Confirmar reserva"/>
                        <Button fx:id="botonCompletarReserva"
                                styleClass="boton-accion-principal"
                                text="Completar reserva"/>
                        <Button fx:id="botonCancelarReserva"
                                styleClass="boton-accion-peligro"
                                text="Cancelar reserva"/>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </content>
</ScrollPane>