<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      styleClass="tarjeta-contenido-principal"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.suenhator.controller.RegistroViewController">

    <padding>
        <!-- solo subo un poco el bottom -->
        <Insets bottom="36" left="30" right="30" top="30"/>
    </padding>

    <VBox spacing="3">
        <Label styleClass="etiqueta-titulo-seccion"
               text="Formulario de registro de cliente"/>
        <Label styleClass="etiqueta-texto-secundario"
               text="Introduce los datos básicos del cliente para darlo de alta en el sistema."
               wrapText="true"/>
    </VBox>

    <GridPane hgap="12"
              vgap="12"
              maxWidth="1.7976931348623157E308"
              VBox.vgrow="ALWAYS">

        <columnConstraints>
            <ColumnConstraints prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
        </columnConstraints>

        <Label text="Nombre"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>
        <TextField fx:id="campoTextoNombreCliente"
                   promptText="Nombre del cliente"
                   styleClass="campo-entrada-datos"
                   maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"
                   GridPane.fillWidth="true"/>

        <Label text="Apellidos"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>
        <TextField fx:id="campoTextoApellidosCliente"
                   promptText="Apellidos del cliente"
                   styleClass="campo-entrada-datos"
                   maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"
                   GridPane.fillWidth="true"/>

        <Label text="DNI"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>
        <TextField fx:id="campoTextoDniCliente"
                   promptText="Documento de identidad"
                   styleClass="campo-entrada-datos"
                   maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"
                   GridPane.fillWidth="true"/>

        <Label text="Teléfono"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>
        <TextField fx:id="campoTextoTelefonoCliente"
                   promptText="Número de teléfono"
                   styleClass="campo-entrada-datos"
                   maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"
                   GridPane.fillWidth="true"/>

        <Label text="Correo"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>
        <TextField fx:id="campoTextoCorreoCliente"
                   promptText="Correo electrónico"
                   styleClass="campo-entrada-datos"
                   maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"
                   GridPane.fillWidth="true"/>

        <Label text="Fecha de nacimiento"
               styleClass="etiqueta-campo-formulario"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>
        <DatePicker fx:id="selectorFechaNacimientoCliente"
                    styleClass="campo-entrada-datos"
                    maxWidth="1.7976931348623157E308"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="5"
                    GridPane.fillWidth="true"/>
    </GridPane>

    <Button fx:id="botonRegistrarNuevoCliente"
            styleClass="boton-accion-principal"
            text="Registrar cliente"/>

    <Button fx:id="botonAtras"
            styleClass="boton-accion-secundaria"
            text="Atrás">
        <!-- margen inferior extra sin cambiar altura de ventana -->
        <VBox.margin>
            <Insets top="4" bottom="12"/>
        </VBox.margin>
    </Button>
</VBox>